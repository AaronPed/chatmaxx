# Don't auto-install peer deps. Vite advertises optional peers for every
# CSS preprocessor (stylus, less, sass, ...) — `legacy-peer-deps` keeps npm
# from probing them. We don't use any.
legacy-peer-deps=true

# Hide the audit table — security scanning is a job for the proxy, not npm.
audit=false
fund=false

# NOTE: optional deps must remain enabled. Rollup ships its native binary
# as an optional dependency (@rollup/rollup-darwin-arm64 etc.) and Vite
# refuses to start without it. The fsevents probe-blocks from the proxy
# are harmless metadata fetches — no code from the blocked package lands
# in node_modules (verified via `ls node_modules/fsevents`).
