# Skip optional deps so npm doesn't probe registry for `fsevents` (macOS
# file watcher used by chokidar/Vite) or other proxy-blocked optionals.
# We lose native FS events on macOS dev (chokidar falls back to polling);
# in containers it has no effect.
omit=optional

# Don't auto-install peer deps. Vite advertises optional peers for every
# CSS preprocessor (stylus, less, sass, ...) — `legacy-peer-deps` keeps npm
# from probing them. We don't use any.
legacy-peer-deps=true

# Hide the audit table — security scanning is a job for the proxy, not npm.
audit=false
fund=false
