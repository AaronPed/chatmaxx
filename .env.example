# --- chatmaxx config ---
# Copy to .env and fill in. Only ADMIN_PASSWORD is strictly required;
# enable a provider by setting its key.

# Postgres (compose creates the DB; just pick a password)
POSTGRES_PASSWORD=chatmaxx

# App
PORT=3000
ADMIN_PASSWORD=change-me-now
IP_HASH_SALT=replace-with-random-32-bytes

# Database URL used by the app (compose builds this from POSTGRES_PASSWORD;
# only set this explicitly if running the app outside compose).
# DATABASE_URL=postgres://chatmaxx:chatmaxx@localhost:5432/chatmaxx

# --- Provider keys (set the ones you'll use) ---
# Each provider row in /admin/providers references one of these by name.
# Add new providers without editing this file — just set whatever env var the
# provider row points at.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# Ollama is keyless. Point this at your Ollama daemon if not co-located.
# (For Ollama, edit the provider's base_url in /admin/providers — the env var
# below is read at startup only as a default for new compose stacks.)
OLLAMA_BASE_URL=http://ollama:11434/v1
